{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@nutriclock/domain": ["packages/domain/src/index.ts"],
      "@nutriclock/application": ["packages/application/src/index.ts"],
      "@nutriclock/persistence": ["packages/persistence/src/index.ts"]
    }
  }
}
